# =============================================================================
# Pulumi state backend — Azure Blob Storage (self-hosted)
# =============================================================================
PULUMI_BACKEND_URL=azblob://your-pulumi-state-container
PULUMI_CONFIG_PASSPHRASE=change-me-to-a-strong-passphrase

# Pulumi Cloud token — leave unset when using the azblob:// backend
# PULUMI_ACCESS_TOKEN=pul-xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Azure Blob backend auth (storage account key)
# =============================================================================
AZURE_STORAGE_ACCOUNT=your-storage-account-name
AZURE_STORAGE_KEY=your-storage-account-primary-key

# =============================================================================
# Azure service principal — used to PROVISION Azure resources.
# Create with:
#   az ad sp create-for-rbac --name "multicloud-demo" --role Contributor \
#     --scopes /subscriptions/<SUBSCRIPTION_ID>
# =============================================================================
ARM_CLIENT_ID=your-service-principal-app-id
ARM_CLIENT_SECRET=your-service-principal-secret
ARM_TENANT_ID=your-azure-tenant-id
ARM_SUBSCRIPTION_ID=your-azure-subscription-id

# =============================================================================
# Optional integrations
# =============================================================================
# Slack notifications
# SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>
